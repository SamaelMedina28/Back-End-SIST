DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/support_system_test"

FRONTEND_URL="http://localhost:3001"
JWT_SECRET="CHANGE_ME"
SESSION_COOKIE_NAME="sist_session"

GOOGLE_CLIENT_ID=""
